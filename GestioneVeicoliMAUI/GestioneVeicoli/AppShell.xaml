<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GestioneVeicoli.Views"
    x:Class="GestioneVeicoli.AppShell">

    <!-- HOME -->
    <FlyoutItem Title="Dashboard Veicoli" Icon="home.png" Route="home">
        <ShellContent Title="Dashboard Veicoli"
                      ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <!-- VEICOLI -->
    <FlyoutItem Title="Veicoli" Icon="car.png" Route="veicoli">
        <ShellContent Title="Veicoli"
                      ContentTemplate="{DataTemplate views:VeicoliPage}" />
    </FlyoutItem>

    <!-- PROPRIETARI -->
    <FlyoutItem Title="Proprietari" Icon="user.png" Route="proprietari">
        <ShellContent Title="Proprietari"
                      ContentTemplate="{DataTemplate views:ProprietarioPage}" />
    </FlyoutItem>

    <!-- MANUTENZIONI -->
    <FlyoutItem Title="Manutenzioni" Icon="wrench.png" Route="manutenzioni">
        <ShellContent Title="Manutenzioni"
                      ContentTemplate="{DataTemplate views:ManutenzioniPage}" />
    </FlyoutItem>

</Shell>
