<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GestioneVeicoli.ViewModels"
             x:Class="GestioneVeicoli.Views.ManutenzioniPage"
             Title="Manutenzioni">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">

            <Label Text="Nuova Manutenzione" FontAttributes="Bold" />

            <Entry Placeholder="Tipo intervento"
                   Text="{Binding NuovaManutenzione.TipoIntervento}" />

            <DatePicker Date="{Binding NuovaManutenzione.Data}" />

            <Button Text="Aggiungi Manutenzione"
                    Command="{Binding AggiungiManutenzioneCommand}" />

            <Label Text="Storico Manutenzioni" FontAttributes="Bold" Margin="0,20,0,0" />

            <CollectionView ItemsSource="{Binding Manutenzioni}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Elimina"
                                               BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ManutenzioneViewModel}}, Path=EliminaManutenzioneCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame BorderColor="Gray" Padding="10" Margin="5" CornerRadius="10">
                                <VerticalStackLayout>
                                    <Label Text="{Binding TipoIntervento}" FontAttributes="Bold" />
                                    <Label Text="{Binding Data, StringFormat='Data: {0:dd/MM/yyyy}'}" />
                                </VerticalStackLayout>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>