<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GestioneVeicoli.Resources.Converters"
             x:Class="GestioneVeicoli.Views.VeicoloDettaglioPage"
             Title="Dettaglio Veicolo">
    <VerticalStackLayout Padding="10">
        <Label Text="Targa:" FontAttributes="Bold" />
        <Entry Text="{Binding Veicolo.Targa,Converter={converters:UpperCaseConverter}}" />

        <Label Text="Marca:" FontAttributes="Bold" />
        <Entry Text="{Binding Veicolo.Marca,Converter={converters:UpperCaseConverter}}" />

        <Label Text="Modello:" FontAttributes="Bold" />
        <Entry Text="{Binding Veicolo.Modello,Converter={converters:UpperCaseConverter}}" />

        <Label Text="Anno:" FontAttributes="Bold" />
        <Entry Text="{Binding Veicolo.Anno}" />
        
        <Label Text="Alimentazione:" FontAttributes="Bold" />
        <Entry Text="{Binding Veicolo.Alimentazione,Converter={converters:UpperCaseConverter}}" />

        <Label Text="KM:" FontAttributes="Bold" />
        <Entry Text="{Binding Veicolo.Km, Mode=TwoWay, Converter={converters:IntToStringConverter}}" Keyboard="Numeric" />

        <Button Text="Salva Modifiche" Command="{Binding SalvaCommand}" />
    </VerticalStackLayout>
</ContentPage>