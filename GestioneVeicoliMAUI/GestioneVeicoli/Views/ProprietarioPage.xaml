<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestioneVeicoli.ViewModels"
             x:Class="GestioneVeicoli.Views.ProprietarioPage"
             Title="ELENCO INTESTATARI VEICOLI">

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Text="Aggiorna" Command="{Binding CaricaProprietariCommand}" />
    </ContentPage.ToolbarItems>-->

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Aggiunta Nuovo Proprietario -->
            <Frame BorderColor="LightGray" Padding="10" CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nuovo Proprietario" FontAttributes="Bold" FontSize="Medium" />
                    <Entry Placeholder="Nome" Text="{Binding NuovoProprietario.Nome}" />
                    <Entry Placeholder="Cognome" Text="{Binding NuovoProprietario.Cognome}" />
                    <Entry Placeholder="Indirizzo" Text="{Binding NuovoProprietario.Indirizzo}" />

                    <Button Text="Aggiungi" Command="{Binding AggiungiProprietarioCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Elenco Proprietari -->
            <CollectionView ItemsSource="{Binding Proprietari}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray" Padding="10" Margin="0,5" CornerRadius="8">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                    <Label Text="{Binding Cognome}" />
                                    <Label Text="{Binding Indirizzo}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>

                                <Button Text="Elimina"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProprietarioViewModel}}, Path=EliminaProprietarioCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Red"
                                        
                                        CornerRadius="5"
                                        Grid.Column="1" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
