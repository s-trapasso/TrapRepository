<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GestioneVeicoli.Resources.Converters"
             xmlns:models="clr-namespace:GestioneVeicoli.Data.Models;assembly=GestioneVeicoli.Data"
             xmlns:vm="clr-namespace:GestioneVeicoli.ViewModels"
             xmlns:picker="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="GestioneVeicoli.Views.VeicoliPage"
             Title="Elenco Veicoli"
             BackgroundColor="#F2F2F2">

    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            <Label  Text="Gestione Veicolo" FontAttributes="Bold" FontSize="18" />
            <Grid ColumnDefinitions="*,*" RowSpacing="15" ColumnSpacing="15" RowDefinitions="*,*">
                <Frame Grid.Column="0" Grid.Row="0" BorderColor="#cccccc" BackgroundColor="White" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="15" >
                        <Label Text="Inserimento nuovo veicolo" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="18"></Label>
                        <Entry Placeholder="Targa" Text="{Binding NewVeicolo.Targa,Converter={converters:UpperCaseConverter}}" />
                        <Entry Placeholder="Marca" Text="{Binding NewVeicolo.Marca,Converter={converters:UpperCaseConverter}}" />
                        <Entry Placeholder="Modello" Text="{Binding NewVeicolo.Modello,Converter={converters:UpperCaseConverter}}" />
                        <Entry Placeholder="Anno" Text="{Binding NewVeicolo.Anno, Mode=TwoWay, Converter={converters:IntToStringConverter}}" Keyboard="Numeric" />
                        <Picker Title="Seleziona un tipo di alimentazione" 
                                ItemsSource="{Binding AlimentazioniDisponibili}"
                                SelectedItem="{Binding NewVeicolo.Alimentazione, Mode=TwoWay}"></Picker>
                        <Entry Placeholder="Km" Text="{Binding NewVeicolo.Km,Mode=TwoWay, Converter={converters:IntToStringConverter}}" Keyboard="Numeric" />
                        <Button Text="💾 Salva Veicolo" Command="{Binding AggiungiCommand}" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1">
                    <VerticalStackLayout Spacing="15" >
                        <Label Text="Elenco di proprietari disponibili" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="18"></Label>
                        <!-- Picker Elenco di proprietari disponibili -->
                        <Picker Title="Seleziona un proprietario"
                    ItemsSource="{Binding Proprietari}"
                    SelectedItem="{Binding SelectedProprietario, Mode=TwoWay}" 
                    ItemDisplayBinding="{Binding NomeCognome}" 
                    IsVisible="{Binding MostraFormNuovoProprietario, Converter={converters:InverseBoolConverter}}"/>

                        <!-- Se NON ci sono proprietari: mostra Form per inserimento -->
                        <StackLayout IsVisible="{Binding MostraFormNuovoProprietario}" Spacing="10">
                            <Label  Text="❗ Nessun proprietario esistente"
                        TextColor="Red"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />
                        </StackLayout>

                        <!-- Form nuovo proprietario: visibile SOLO se MostraFormNuovoProprietario == true -->
                        <StackLayout IsVisible="{Binding MostraFormNuovoProprietario}">
                            <Label Text="Dati Proprietario"
                        FontAttributes="Bold"
                        FontSize="16"
                        Margin="0,10,0,0" />
                            <Entry Placeholder="Nome"
                        Text="{Binding Proprietario.Nome,Converter={converters:UpperCaseConverter}}" />
                            <Entry Placeholder="Cognome"
                        Text="{Binding Proprietario.Cognome,Converter={converters:UpperCaseConverter}}" />
                            <Entry Placeholder="Indirizzo"
                        Text="{Binding Proprietario.Indirizzo,Converter={converters:UpperCaseConverter}}" />
                        </StackLayout>

                        
                    </VerticalStackLayout>
                </Frame>
                <!-- ======================== Lista dei Veicoli ======================== -->
                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2">
                    <Label Text="Veicoli Registrati" FontAttributes="Bold" FontSize="18" />
                    <Frame Grid.Row="1" Grid.ColumnSpan="2">
                        <VerticalStackLayout>
                            <CollectionView ItemsSource="{Binding Veicoli}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame BorderColor="#dddddd" BackgroundColor="White" CornerRadius="10" Padding="10" Margin="0,5">
                                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">                                                
                                                 <!--Dati veicolo-->
                                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                    <Label Text="{Binding Targa}" FontAttributes="Bold" FontSize="16" />
                                                    <Label Text="{Binding Marca}" FontSize="14" />
                                                    <Label Text="{Binding Modello}" FontSize="14" />
                                                    <Label Text="{Binding Proprietario.Nome}" FontSize="13" TextColor="Gray" />
                                                </VerticalStackLayout>
                                                <!--Pulsanti Azioni-->
                                                <Button Grid.Column="1"
                                                        Text="✏️"
                                                        BackgroundColor="Transparent"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VeicoloViewModel}}, Path=SelezionaVeicoloCommand}"
                                                        CommandParameter="{Binding .}" />

                                                <Button Grid.Column="1"
                                                        Text="👤"
                                                        BackgroundColor="Transparent"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VeicoloViewModel}}, Path=SelezionaProprietarioCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Grid.Column="2"
                                                        Text="🗑️"
                                                        BackgroundColor="Transparent"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VeicoloViewModel}}, Path=EliminaCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Grid>

            
            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
