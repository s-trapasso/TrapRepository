<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GestioneVeicoli.Resources.Converters"
             xmlns:models="clr-namespace:GestioneVeicoli.Data.Models;assembly=GestioneVeicoli.Data"
             xmlns:vm="clr-namespace:GestioneVeicoli.ViewModels"
             x:Class="GestioneVeicoli.Views.VeicoliPage"
             Title="Elenco Veicoli"
             BackgroundColor="#F2F2F2">

    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- ======================== Form di Inserimento/Modifica ======================== -->
            <Frame BorderColor="#cccccc" BackgroundColor="White" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gestione Veicolo" FontAttributes="Bold" FontSize="18" />

                    <Entry Placeholder="Targa" Text="{Binding NewVeicolo.Targa,Converter={converters:UpperCaseConverter}}" />
                    <Entry Placeholder="Marca" Text="{Binding NewVeicolo.Marca,Converter={converters:UpperCaseConverter}}" />
                    <Entry Placeholder="Modello" Text="{Binding NewVeicolo.Modello,Converter={converters:UpperCaseConverter}}" />
                    <Entry Placeholder="Anno" Text="{Binding NewVeicolo.Anno, Mode=TwoWay, Converter={converters:IntToStringConverter}}" Keyboard="Numeric" />
                    
                    <!--<Entry Placeholder="Alimentazione" Text="{Binding NewVeicolo.Alimentazione,Converter={converters:UpperCaseConverter}}" />-->
                    <Picker Title="Alimentazione" 
                            ItemsSource="{Binding AlimentazioniDisponibili}"
                            SelectedItem="{Binding NewVeicolo.Alimentazione, Mode=TwoWay}"></Picker>
                    
                    <Entry Placeholder="Km" Text="{Binding NewVeicolo.Km,Mode=TwoWay, Converter={converters:IntToStringConverter}}" Keyboard="Numeric" />

                    <Label Text="Dati Proprietario" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0" />
                    <Entry Placeholder="Nome" Text="{Binding Proprietario.Nome,Converter={converters:UpperCaseConverter}}" />
                    <Entry Placeholder="Cognome" Text="{Binding Proprietario.Cognome,Converter={converters:UpperCaseConverter}}" />
                    <Entry Placeholder="Indirizzo" Text="{Binding Proprietario.Indirizzo,Converter={converters:UpperCaseConverter}}" />

                    <Button Text="💾 Salva Veicolo" Command="{Binding AggiungiCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- ======================== Lista dei Veicoli ======================== -->
            <Label Text="Veicoli Registrati" FontAttributes="Bold" FontSize="18" />

            <CollectionView ItemsSource="{Binding Veicoli}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#dddddd" BackgroundColor="White" CornerRadius="10" Padding="10" Margin="0,5">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <!-- Dati veicolo -->
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Targa}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Marca}" FontSize="14" />
                                    <Label Text="{Binding Modello}" FontSize="14" />
                                    <Label Text="{Binding Proprietario.Nome}" FontSize="13" TextColor="Gray" />
                                </VerticalStackLayout>

                                <!-- Pulsanti Azioni -->
                                <Button Grid.Column="1"
                                    Text="✏️"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VeicoloViewModel}}, Path=SelezionaVeicoloCommand}"
                                    CommandParameter="{Binding .}" />
                                
                                <Button Grid.Column="1"
                                    Text="👤"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VeicoloViewModel}}, Path=SelezionaProprietarioCommand}"
                                    CommandParameter="{Binding .}" />
                                <Button Grid.Column="2"
                                    Text="🗑️"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VeicoloViewModel}}, Path=EliminaCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
