@page "/vehicles/create"
@using CarManager.App.Models.Vehicle
@using CarManager.App.Services.Interfaces

@using CarManager.Core.Enums
@inject IVehicleApiClient VehicleApiClient
@inject NavigationManager Nav


<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="p-4">
        <MudText Typo="Typo.h4" GutterBottom="true">Nuovo Veicolo</MudText>
        <MudForm @ref="_newVehicleForm">
            <MudGrid Spacing="3">
                <!-- TARGA -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Targa"
                                  @bind-Value="_newVehicle.Plate"
                                  Required="true"
                                  For="@(() => _newVehicle.Plate)" />
                </MudItem>
                <!-- MARCA -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Marca"
                                  @bind-Value="_newVehicle.Brand"
                                  Required="true"
                                  For="@(() => _newVehicle.Brand)" />
                </MudItem>
                <!-- MODELLO -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Modello"
                                  @bind-Value="_newVehicle.Model"
                                  Required="true"
                                  For="@(() => _newVehicle.Model)" />
                </MudItem>
                <!-- ANNO -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Anno"
                                  @bind-Value="_newVehicle.Year"
                                  Required="true"
                                  For="@(() => _newVehicle.Year)" />
                </MudItem>
                <!-- ALIMENTAZIONE -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="FuelTypeEnum"
                               Label="Alimentazione"
                               @bind-Value="_newVehicle.FuelType"
                               Required="true"
                               For="@(() => _newVehicle.FuelType)">
                        @foreach (var fuel in Enum.GetValues<FuelTypeEnum>())
                        {
                            <MudSelectItem Value="@fuel">@fuel</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <!-- KM -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Km"
                                  @bind-Value="_newVehicle.Km"
                                  Required="true"
                                  For="@(() => _newVehicle.Km)" />
                </MudItem>

                <!--BUTTONS-->
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="HandleValidSubmit"
                               Disabled="_isSaving">
                        @(_isSaving ? "Salvataggio..." : "Salva")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Class="ms-2"
                               OnClick="GoBack">
                        Annulla
                    </MudButton>
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
                    }
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
</MudContainer>


@code {
    private MudForm? _newVehicleForm;
    private VehicleCreateModel _newVehicle = new();
    private bool _isSaving = false;
    private string? _errorMessage;

    private async Task HandleValidSubmit()
    {
        _isSaving = true;
        _errorMessage = null;
        try
        {
            // Call the API to create the new vehicle
            var created = await VehicleApiClient.CreateVehicleAsync(_newVehicle);
            // Optionally, navigate to the vehicle list or show a success message
            Nav.NavigateTo("/vehicles");
        }
        catch (Exception ex)
        {
            _errorMessage = "Errore durante la creazione del veicolo: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
    
    private void GoBack()
    {
        Nav.NavigateTo("/vehicles");
    }
}
