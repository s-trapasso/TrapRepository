@page "/vehicles"
@using CarManager.App.Components.Pages.Commons
@using CarManager.App.Models.Vehicle
@using CarManager.App.Services.Interfaces
@inject IVehicleApiClient VehicleApiClient
@inject NavigationManager Nav
@inject IDialogService DialogService

<MudContainer>
    <MudPaper Class="p-4 mb-4">

        <!-- HEADER: titolo + descrizione al centro -->
        <MudStack Direction="Row"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-3">

            <!-- blocco testo -->
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" Class="dashboard-text-h4">
                    Elenco Veicoli
                </MudText>
                <MudText Class="dashboard-text-h4">
                    Visualizza tutti i veicoli registrati nel sistema.
                </MudText>
            </MudStack>

            <!-- bottone al centro -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Nav.NavigateTo("/vehicles/create"))">
                Nuovo veicolo
            </MudButton>
        </MudStack>

        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mt-6">
                <MudProgressCircular Size="Size.Large"
                                     Indeterminate="true"
                                     Color="Color.Primary" />
                <MudText Typo="Typo.body1">Caricamento...</MudText>
            </MudStack>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Info" Elevation="0" Class="page-alert">@_errorMessage</MudAlert>
        }
        else if (_vehicles is null || !_vehicles.Any())
        {
            <MudAlert Severity="Severity.Info" Elevation="0" Class="page-alert">Nessun veicolo trovato.</MudAlert>
        }
        else
        {
            <MudTable Items="_vehicles" Hover="true" Dense="true" Striped="true" Class="page-table">
                <HeaderContent>
                    <MudTh>Targa</MudTh>
                    <MudTh>Marca</MudTh>
                    <MudTh>Modello</MudTh>
                    <MudTh>Anno</MudTh>
                    <MudTh>Alimentazione</MudTh>
                    <MudTh>KM</MudTh>
                    <MudTh>Azioni</MudTh> @*colonna azioni*@
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Targa">@context.Plate</MudTd>
                    <MudTd DataLabel="Marca">@context.Brand</MudTd>
                    <MudTd DataLabel="Modello">@context.Model</MudTd>
                    <MudTd DataLabel="Anno">@context.Year</MudTd>
                    <MudTd DataLabel="Alimentazione">@context.FuelTypeName</MudTd>
                    <MudTd DataLabel="KM">@context.Km</MudTd>
                    <MudTd>
                        <MudMenu Icon="@Icons.Material.Filled.Menu" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem OnClick="@(() => EditVehicle(context.Id))">Modifica</MudMenuItem>
                            <MudMenuItem OnClick="@(() => DeleteVehicle(context))">Elimina</MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

    </MudPaper>
</MudContainer>


@code {

    private List<VehicleModel>? _vehicles;
    private bool _isLoading = true;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vehicles = (await VehicleApiClient.GetAllVehiclesAsync()).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Errore durante il caricamento dei veicoli: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void EditVehicle(int vehicleId)
    {
        Nav.NavigateTo($"/vehicles/edit/{vehicleId}");
    }
    private async Task DeleteVehicle(VehicleModel vehicle)
    {
        var parameters = new DialogParameters
        {
            { "Message", $"Sei sicuro di voler eliminare il veicolo '{vehicle.Brand} {vehicle.Model}'?" },
            { "ConfirmButtonText", "Elimina" },
            { "Color", Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Conferma eliminazione", parameters, options);
        DialogResult? result = await dialog.Result;
        if (!result.Canceled)
        {
            try
            {
                await VehicleApiClient.DeleteVehicleAsync(vehicle.Id);
                _vehicles?.Remove(vehicle);
                await OnInitializedAsync();
            }
            catch (Exception ex)
            {
                _errorMessage = $"Errore durante l'eliminazione del veicolo: {ex.Message}";
            }
        }
    }
}
