@page "/owners/create"
@using CarManager.App.Models.Owner
@using CarManager.App.Services.Interfaces

@inject IOwnerApiClient OwnerApiClient
@inject NavigationManager Nav

<MudPaper Class="p-4">
    <MudText Typo="Typo.h5">Nuovo Proprietario</MudText>

    <OwnerForm Model="_model"
               SubmitText="Crea"
               OnSubmit="Create"
               OnCancel="GoBack" />
</MudPaper>

@code {
    private OwnerCreateModel _model = new();

    private async Task Create()
    {
        await OwnerApiClient.CreateOwnerAsync(_model);
        Nav.NavigateTo("/owners");
    }

    private void GoBack() => Nav.NavigateTo("/owners");
}