@page "/owners/create"
@using CarManager.App.Models.Owner
@using CarManager.App.Services.Interfaces

@inject IOwnerApiClient OwnerApiClient
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="p-4">
        <MudText Typo="Typo.h4" GutterBottom="true">Crea Nuovo Proprietario</MudText>
        <MudForm @ref="_ownerCreateForm">
            <MudGrid Spacing="3">
                <!-- NOME -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Targa"
                                  @bind-Value="_newOwner.FirstName"
                                  Required="true"
                                  For="@(() => _newOwner.FirstName)" />
                </MudItem>
                <!-- COGNOME -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Cognome"
                                  @bind-Value="_newOwner.LastName"
                                  Required="true"
                                  For="@(() => _newOwner.LastName)" />
                </MudItem>
                <!-- INDIRIZZO -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Indirizzo"
                                  @bind-Value="_newOwner.Address"
                                  Required="true"
                                  For="@(() => _newOwner.Address)" />
                </MudItem>
                <!-- DATA DI NASCITA -->
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data di Nascita"
                                   @bind-Date="_newOwner.BirthDate"
                                   Required="true"
                                   For="@(() => _newOwner.BirthDate)" />
                </MudItem>
                <!-- LUOGO DI NASCITA -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Luogo di Nascita"
                                  @bind-Value="_newOwner.BirthPlace"
                                  Required="true"
                                  For="@(() => _newOwner.BirthPlace)" />
                </MudItem>
                <!-- SESSO -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Sesso"
                                  @bind-Value="_newOwner.Gender"
                                  Required="true"
                                  For="@(() => _newOwner.Gender)"/>
                </MudItem>
                <!-- CODICE FISCALE -->
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Codice Fiscale"
                                  @bind-Value="_newOwner.FiscalCode"
                                  Required="true"
                                  For="@(() => _newOwner.FiscalCode)" />
                </MudItem>
                <!--BUTTONS-->
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="HandleValidSubmit"
                               Disabled="_isSaving">
                        @(_isSaving ? "Salvataggio..." : "Salva")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Class="ms-2"
                               OnClick="GoBack">
                        Annulla
                    </MudButton>
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
                    }
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
</MudContainer>


@code {
    private MudForm? _ownerCreateForm;
    private OwnerCreateModel _newOwner = new();
    private bool _isSaving = false;
    private string? _errorMessage;

    private async Task HandleValidSubmit()
    {
        _isSaving = true;
        _errorMessage = null;
        try
        {
            // Call the API to create the new owner
            var created = await OwnerApiClient.CreateOwnerAsync(_newOwner);
            // Optionally, navigate to the owners list or show a success message
            Nav.NavigateTo("/owners");
        }
        catch (Exception ex)
        {
            _errorMessage = "Errore durante la creazione del proprietario: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/owners");
    }
}