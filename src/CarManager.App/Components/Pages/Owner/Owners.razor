@page "/owners"
@using CarManager.App.Models.Owner
@using CarManager.App.Services.Interfaces
@using CarManager.App.Components.Pages.Commons
@inject IOwnerApiClient OwnerApiClient
@inject NavigationManager Nav
@inject IDialogService DialogService


<MudContainer>
    <MudPaper Class="p-4 mb-4">

        <!-- HEADER: titolo + descrizione al centro -->
        <MudStack Direction="Row"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-3">

            <!-- blocco testo -->
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" Class="dashboard-text-h4">
                    Elenco Proprietari
                </MudText>
                <MudText Class="dashboard-text-h4">
                    Visualizza tutti i proprietari registrati nel sistema.
                </MudText>
            </MudStack>

            <!-- bottone al centro -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Nav.NavigateTo("/owners/create"))">
                Nuovo proprietario
            </MudButton>
        </MudStack>

        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mt-6">
                <MudProgressCircular Size="Size.Large"
                                     Indeterminate="true"
                                     Color="Color.Primary" />
                <MudText Typo="Typo.body1">Caricamento...</MudText>
            </MudStack>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Info" Elevation="0" Class="page-alert">@_errorMessage</MudAlert>
        }
        else if (_owners is null || !_owners.Any())
        {
            <MudAlert Severity="Severity.Info" Elevation="0" Class="page-alert">Nessun proprietario trovato.</MudAlert>
        }
        else
        {
            <MudTable Items="_owners" Hover="true" Dense="true" Striped="true" Class="page-table">
                <HeaderContent>
                    <MudTh>Nome</MudTh>
                    <MudTh>Cognome</MudTh>
                    <MudTh>Indirizzo</MudTh>
                    <MudTh>Data di nascita</MudTh>
                    <MudTh>Luogo di Nascita</MudTh>
                    <MudTh>Sesso</MudTh>
                    <MudTh>Codice Fiscale</MudTh>
                    <MudTh>Azioni</MudTh> @*colonna azioni*@
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nome">@context.FirstName</MudTd>
                    <MudTd DataLabel="Cognome">@context.LastName</MudTd>
                    <MudTd DataLabel="Indirizzo">@context.Address</MudTd>
                    <MudTd DataLabel="Data di nascita">@context.BirthDate</MudTd>
                    <MudTd DataLabel="Luogo di Nascita">@context.BirthPlace</MudTd>
                    <MudTd DataLabel="Sesso">@context.Gender</MudTd>
                    <MudTd DataLabel="Codice Fiscale">@context.FiscalCode</MudTd>
                    <MudTd>
                        <MudMenu Icon="@Icons.Material.Filled.Menu" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem OnClick="@(() => EditOwner(context.Id))">Modifica</MudMenuItem>
                            <MudMenuItem OnClick="@(() => DeleteOwner(context))">Elimina</MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

    </MudPaper>
</MudContainer>

@code {

    private List<OwnerModel>? _owners;
    private bool _isLoading = true;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _owners = (await OwnerApiClient.GetAllOwnersAsync()).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Errore durante il caricamento dei proprietari: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
    private void EditOwner(int ownerId)
    {
        Nav.NavigateTo($"/owners/edit/{ownerId}");
    }
    private async Task DeleteOwner(OwnerModel owner)
    {
        var parameters = new DialogParameters
        {
            { "Message", $"Sei sicuro di voler eliminare il proprietario '{owner.FirstName} {owner.LastName}'?" },
            { "ConfirmButtonText", "Elimina" },
            { "Color", Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small , CloseOnEscapeKey = true};
        IDialogReference dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Conferma eliminazione", parameters, options);
        DialogResult? result = await dialog.Result;
        if (!result.Canceled)
        {
            try
            {
                await OwnerApiClient.DeleteOwnerAsync(owner.Id);
                _owners?.Remove(owner);
                await OnInitializedAsync();
            }
            catch (Exception ex)
            {
                _errorMessage = $"Errore durante l'eliminazione del proprietario: {ex.Message}";
            }
        }
    }
}

