@using CarDesk.Data.Models
@using CarDesk.Data.Models.Enum
@using CarDesk.Data.Services.Functions
@using CarDesk.Data.Services.Interfaces
@using CodiceFiscaleLib
@inject IRepositoryManager RepositoryManager
@inject ILoggingService<ProprietariForm> Log
@inject IDialogService DialogService
@inject PatenteService PatenteService
@inject IErrorHandlerService ErrorHandler

<MudForm Model="Proprietario" @ref="formProprietario" @bind-IsValid="formIsValid">

    <!-- === CAMPI PROPRIETARIO =================================================== -->
    <MudTextField Label="Nome" @bind-Value="Proprietario.Nome" Required="true" For="@(() => Proprietario.Nome)"></MudTextField>
    <MudTextField Label="Cognome" @bind-Value="Proprietario.Cognome" Required="true" For="@(() => Proprietario.Cognome)"></MudTextField>
    <MudTextField Label="Indirizzo" @bind-Value="Proprietario.Indirizzo" Required="true" For="@(() => Proprietario.Indirizzo)"></MudTextField>
    <MudDatePicker Label="Data di nascita" @bind-Date="Proprietario.DataNascita" DateFormat="dd-MM-yyyy" Required="true" For="@(() => Proprietario.DataNascita)"/>
    <MudTextField Label="Luogo di nascita" @bind-Value="Proprietario.LuogoNascita" Required="true" For="@(() => Proprietario.LuogoNascita)"></MudTextField>

    <MudSelect Label="Sesso" @bind-Value="Proprietario.Sesso" Required="true" Clearable="true" For="@(() => Proprietario.Sesso)">
        <MudSelectItem T="string" Value="@("")">Seleziona...</MudSelectItem>
        <MudSelectItem T="string" Value="@("M")">Maschio</MudSelectItem>
        <MudSelectItem T="string" Value="@("F")">Femmina</MudSelectItem>
    </MudSelect>
    <MudTextField @bind-Value="Proprietario.CodiceFiscale"
                  Label="Codice Fiscale"
                  ReadOnly="true"
                  For="@(() => Proprietario.CodiceFiscale)"
                  Error="@(!string.IsNullOrEmpty(codiceFiscaleErrore))"
                  ErrorText="@codiceFiscaleErrore" />

    <MudButton Variant="Variant.Filled" Color="Color.Info" Disabled="!DatiCompletiPerCodiceFiscale()" OnClick="CalcolaCodiceFiscale" Class="mb-3">
        Calcola Codice Fiscale
    </MudButton>

    <!-- === PATENTE ========================================================= -->
    <MudTextField Label="N° Patente" @bind-Value="Proprietario.NumeroPatente" Required="true" For="@(() => Proprietario.NumeroPatente)"></MudTextField>
    @* <MudDatePicker Label="Data di rilascio" @bind-Date="Proprietario.DataRilascioPatente" DateFormat="dd-MM-yyyy" Required="true" For="@(() => Proprietario.DataRilascioPatente)"></MudDatePicker> *@
    <MudDatePicker Label="Data di rilascio"
               Date="Proprietario.DataRilascioPatente"
               DateChanged="OnDateRilascioChanged"
               Immediate="true"
               DateFormat="dd-MM-yyyy"
               Required="true"
               For="@(() => Proprietario.DataRilascioPatente)">
    </MudDatePicker>
    
    <MudDatePicker Label="Data di scadenza" @bind-Date="Proprietario.DataScadenzaPatente" DateFormat="dd-MM-yyyy" Required="true" For="@(() => Proprietario.DataScadenzaPatente)"></MudDatePicker>
    <MudText Typo="Typo.h6" Class="mt-2">@StatoPatente</MudText>

    <MudSelect T="CategoriaPatenteEnum" Label="Categoria Patente" MultiSelection="true" @bind-SelectedValues="_categorieSelezionate">
        @foreach (var valoreCategoria in Enum.GetValues<CategoriaPatenteEnum>())
        {
            <MudSelectItem T="CategoriaPatenteEnum" Value="@valoreCategoria">@valoreCategoria</MudSelectItem>
        }
    </MudSelect>

    

    <!-- === BOTTONI ========================================================= -->
    <MudStack Direction="Row" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SalvaAsync()">Salva</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => OnAnnulla.InvokeAsync()">Annulla</MudButton>
        @if (Proprietario.Id != 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" Class="ms-auto" ButtonType="ButtonType.Button" OnClick="() => ConfermaEliminazioneDaFormAsync()">Elimina nominativo</MudButton>
        }
    </MudStack>
</MudForm>


@code {


    /* ---------- PARAMETRI DAL PADRE -------------------------- */
    [Parameter] public Proprietario Proprietario { get; set; } = new();
    [Parameter] public EventCallback<Proprietario> OnSalvato { get; set; }
    [Parameter] public EventCallback OnAnnulla { get; set; }

    /* ---------- DATI DI SUPPORTO ----------------------------- */
    private List<Proprietario> proprietari = new();
    private bool isNuovoProprietario;
    private Proprietario nuovoProprietario = new();
    private string? codiceFiscaleErrore;
    MudForm formProprietario;
    bool formIsValid;
    #region PATENTE
    private IEnumerable<CategoriaPatenteEnum> _categorieSelezionate = new HashSet<CategoriaPatenteEnum>();
    private bool GestisciRinnovi { get; set; } = false;
    private int NumeroRinnovi { get; set; } = 0;
    private DateTime ultimaScadenza;
    private string StatoPatente { get; set; } = string.Empty;

    #endregion

    protected override void OnInitialized()
    {
        _categorieSelezionate = Proprietario.CategoriePatente;
    }


    //Gestione date patente
    private async Task OnDateRilascioChanged(DateTime? newDate)
    {
        if (!newDate.HasValue) return;

        DateTime dataSelezionata = newDate.Value;

        // Controllo data futura
        if (dataSelezionata > DateTime.Now)
        {
            await ErrorHandler.HandleAsync(new InvalidOperationException("La data di rilascio non può essere futura."));
            return;
        }

        // Controllo data precedente alla nascita
        if (Proprietario.DataNascita.HasValue && dataSelezionata < Proprietario.DataNascita.Value)
        {
            await ErrorHandler.HandleAsync(new InvalidOperationException("La data di rilascio non può essere precedente alla data di nascita."));
            return;
        }

        // Controllo età minima
        if (Proprietario.DataNascita.HasValue)
        {
            int eta = PatenteService.CalcolaEta(Proprietario.DataNascita.Value, dataSelezionata);
            if (eta < 18)
            {
                await ErrorHandler.HandleAsync(new InvalidOperationException("Il proprietario deve avere almeno 18 anni al momento del rilascio."));
                return;
            }
        }

        // Se tutte le verifiche sono OK, aggiorna e apri dialog
        Proprietario.DataRilascioPatente = dataSelezionata;

        var parameters = new DialogParameters { ["DataRilascio"] = dataSelezionata };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialogRef = DialogService.Show<RinnovoPatenteDialog>("Rinnovo patente", parameters, options);
        var result = await dialogRef.Result;

        if (!result.Canceled && result.Data is DateTime dataRinnovo)
        {
            Proprietario.DataUltimoRinnovo = dataRinnovo;
        }

        await AggiornaScadenza();
    }

    private async Task OnUltimoRinnovoChanged(DateTime? newDate)
    {
        Proprietario.DataUltimoRinnovo = newDate;
        await AggiornaScadenza();
    }
    private async Task AggiornaScadenza()
    {
        try
        {
            if (!Proprietario.DataNascita.HasValue || !Proprietario.DataRilascioPatente.HasValue)
            {
                StatoPatente = "Dati mancanti";
                Proprietario.DataScadenzaPatente = null;
                return;
            }
    
            var risultato = PatenteService.CalcolaScadenzaConVerifica(
                Proprietario.DataNascita,
                Proprietario.DataRilascioPatente,
                Proprietario.DataUltimoRinnovo
            );
    
            Proprietario.DataScadenzaPatente = risultato.dataScadenza;
            StatoPatente = risultato.patenteValida ? "✅ OK - patente valida" : "❌ KO - patente scaduta";
        }
        catch (Exception ex)
        {
            await ErrorHandler.HandleAsync(ex, ex.Message);
            StatoPatente = "Errore nel calcolo";
        }
    
        StateHasChanged();
    }

    /* ---------- SALVATAGGIO PROPRIETARIO -------------------------- */
    async Task SalvaAsync()
    {
        try
        {
            await formProprietario.Validate();
            if (formIsValid)
            {
                //Calcolo scadenza patente
                try
                {
                    if (!Proprietario.DataScadenzaPatente.HasValue)
                        throw new InvalidOperationException("La data di scadenza della patente non è valida. Verificare le date inserite.");
                }
                catch (Exception ex)
                {
                    await ErrorHandler.HandleAsync(ex, "Errore durante il calcolo della scadenza della patente.\nVerificare le date inserite!");
                    Log.LogError(ex, "Errore durante il calcolo della scadenza della patente per il proprietario {0} {1}", Proprietario.Nome, Proprietario.Cognome);
                    

                    // Potresti mostrare un messaggio all'utente
                }

                // Aggiorna la proprietà CategoriaPatente prima del salvataggio
                Proprietario.CategoriePatente = _categorieSelezionate.ToList();

                if (Proprietario.Id == 0)
                    await RepositoryManager.For<Proprietario>().AddAsync(Proprietario);
                else
                    await RepositoryManager.For<Proprietario>().UpdateAsync(Proprietario);

                Log.LogInformation("Salvato proprietario {0} {1}", Proprietario.Nome, Proprietario.Cognome);
                await OnSalvato.InvokeAsync(Proprietario);
            }
        }
        catch (Exception ex)
        {
            await ErrorHandler.HandleAsync(ex, "");
            Log.LogError(ex, "Errore salvataggio proprietario {0} {1}", Proprietario.Nome, Proprietario.Cognome);
        }
    }

    /* ---------- ELIMINAZIONE DEL VEICOLO ---------- */
    private async Task ConfermaEliminazioneDaFormAsync()
    {
        var parameters = new DialogParameters
        {
            ["Parameters"] = new Dictionary<string, object>
                {
                    { "Nome", Proprietario.Nome },
                    { "Cognome", Proprietario.Cognome }
                }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };

        IDialogReference dialog = await DialogService.ShowAsync<ConfermaEliminazioneDialog>("Conferma eliminazione", parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await RepositoryManager.For<Proprietario>().DeleteAsync(Proprietario.Id);
                Log.LogInformation("Proprietario eliminato: {0} {1}", Proprietario.Nome, Proprietario.Cognome);
                await OnAnnulla.InvokeAsync(); // torna alla lista dopo l'eliminazione
            }
            catch (Exception ex)
            {
                Log.LogError(ex, "Errore durante l'eliminazione del proprietario {0} {1}", Proprietario.Nome, Proprietario.Cognome);
                // potresti mostrare un messaggio all'utente
            }
        }
    }


    //---------GESTIONE DATI PER CALCOLO CODICE FISCALE-----------//

    //----VERIFICA SE I DATI PER IL CALCOLO DEL CODICE FISCALE SONO VALIDI E PRESENTI
    private bool DatiCompletiPerCodiceFiscale() => !string.IsNullOrWhiteSpace(Proprietario.Nome) &&
                                                    !string.IsNullOrWhiteSpace(Proprietario.Cognome) &&
                                                    Proprietario.DataNascita != default &&
                                                    !string.IsNullOrWhiteSpace(Proprietario.LuogoNascita) &&
                                                    !string.IsNullOrWhiteSpace(Proprietario.Sesso);

    private void CalcolaCodiceFiscale()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Proprietario.Nome) ||
                        string.IsNullOrWhiteSpace(Proprietario.Cognome) ||
                        Proprietario.DataNascita == default ||
                        string.IsNullOrWhiteSpace(Proprietario.LuogoNascita) ||
                        string.IsNullOrWhiteSpace(Proprietario.Sesso.ToString()))
            {
                Log.LogWarning("Dati insufficienti per calcolare il codice fiscale.");
                return;
            }
            char sessoChar = !string.IsNullOrWhiteSpace(Proprietario.Sesso) ? Proprietario.Sesso[0] : 'M'; // Default a 'M' se non specificato)
            Proprietario.CodiceFiscale = CodiceFiscaleLib.Helpers.EncodingHelper.Encode(Proprietario.Cognome, Proprietario.Nome, sessoChar, Proprietario.DataNascita, Proprietario.LuogoNascita);
            codiceFiscaleErrore = null;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Errore calcolo codice fiscale per proprietario {0} {1}", Proprietario.Nome, Proprietario.Cognome);
            codiceFiscaleErrore = ex.Message;
        }
    }


    

}
