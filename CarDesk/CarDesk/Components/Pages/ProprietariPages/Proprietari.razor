@page "/proprietari"
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject NavigationManager Nav
@inject ILoggingService<Proprietari> Log
@inject IDialogService DialogService

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">Elenco proprietari</MudText>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Nav.NavigateTo("/proprietari/nuovo"))">
        Nuovo Proprietario
    </MudButton>
    @if (proprietari == null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary">Caricamento...</MudProgressCircular>
    }
    else if (!proprietari.Any())
    {
        <MudAlert Severity="Severity.Info" Elevation="0" Class="mt-4">Nessun proprietario registrato.</MudAlert>
    }
    else
    {
        <MudTable Items="proprietari" Hover="true" Dense="true" Striped="true" Class="mt-4">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Cognome</MudTh>
                <MudTh>Indirizzo</MudTh>
                <MudTh>Data di nascita</MudTh>
                <MudTh>Luogo di nascita</MudTh>
                <MudTh>Chilometri</MudTh>
                <MudTh>Codice Fiscale</MudTh>
                <MudTh>N° Patente</MudTh>
                <MudTh>Data di rilascio</MudTh>
                <MudTh>Data di scadenza</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nome">@context.Nome</MudTd>
                <MudTd DataLabel="Cognome">@context.Cognome</MudTd>
                <MudTd DataLabel="Indirizzo">@context.Indirizzo</MudTd>
                <MudTd DataLabel="Data di nascita">@context.DataNascita.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Luogo di nascita">@context.LuogoNascita</MudTd>
                <MudTd DataLabel="CodiceFiscale">@context.CodiceFiscale</MudTd>
                <MudTd DataLabel="NumeroPatente">@context.NumeroPatente</MudTd>
                <MudTd DataLabel="DataRilascioPatente">@context.DataRilascioPatente.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="DataScadenzaPatente">@context.DataScadenzaPatente.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                   OnClick="@(() => Nav.NavigateTo($"/proprietari/edit/{context.Id}"))" />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="@(() => ConfermaEliminazioneProprietarioAsync(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>
@code {
    private List<Veicolo>? veicoli;
    private List<Proprietario>? proprietari;
    private List<Manutenzione>? manutenzioni;
    // private bool confermaElimina;
    private Proprietario? proprietarioSelezionato;


    protected override async Task OnInitializedAsync()
    {
        var datiIniziali = await RepositoryManager.CaricaDatiInizialiAsync();

        veicoli = datiIniziali.Veicoli;
        proprietari = datiIniziali.Proprietari;
        manutenzioni = datiIniziali.Manutenzioni;
    }

    /* ---------- ELIMINAZIONE DELLA MANUTENZIONE ---------- */
    private async Task ConfermaEliminazioneProprietarioAsync(Proprietario proprietario)
    {
        var parameters = new DialogParameters
        {
            ["Parameters"] = new Dictionary<string, object>
                {
                    { "Nome", proprietario.Nome },
                    { "Cognome", proprietario.Cognome }
                }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };

        IDialogReference dialog = await DialogService.ShowAsync<ConfermaEliminazioneDialog>("Conferma eliminazione", parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            await RepositoryManager.For<Proprietario>().DeleteAsync(proprietario.Id);
            await OnInitializedAsync();
        }
    }
}
