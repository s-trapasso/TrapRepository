@page "/proprietari"
@using CarDesk.Data.Models.Enum
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject NavigationManager Nav
@inject ILoggingService<Proprietari> Log
@inject IDialogService DialogService

<MudPaper Class="page-container">

    <div class="page-header">
        <MudText Typo="Typo.h5">Elenco Proprietari</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Nav.NavigateTo("/proprietari/nuovo"))">
            Nuovo Proprietario
        </MudButton>
    </div>

    @if (proprietari == null)
    {
        <div class="page-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText>Caricamento...</MudText>
        </div>
    }
    else if (!proprietari.Any())
    {
        <MudAlert Severity="Severity.Info" Elevation="0" Class="page-alert">
            Nessun proprietario registrato.
        </MudAlert>
    }
    else
    {
        <MudTable Items="proprietari"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Breakpoint="Breakpoint.Sm"
                  Class="page-table">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Cognome</MudTh>
                <MudTh>Codice Fiscale</MudTh>
                <MudTh>Azioni</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nome">@context.Nome</MudTd>
                <MudTd DataLabel="Cognome">@context.Cognome</MudTd>
                <MudTd DataLabel="Codice Fiscale">@context.CodiceFiscale</MudTd>
                <MudTd>
                    <ActionButtons OnEdit="@(() => Nav.NavigateTo($"/proprietari/edit/{context.Id}"))"
                                   OnDelete="@(() => ConfermaEliminazioneProprietarioAsync(context))"
                                   OnDetail="@(() => MostraDettaglio(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<Veicolo>? veicoli;
    private List<Proprietario>? proprietari;
    private List<Manutenzione>? manutenzioni;
    // private bool confermaElimina;
    private Proprietario? proprietarioSelezionato;
    private List<CategoriaPatenteEnum> categoriePatenteSelezionate = new();

    protected override async Task OnInitializedAsync()
    {
        var datiIniziali = await RepositoryManager.CaricaDatiInizialiAsync();

        veicoli = datiIniziali.Veicoli;
        proprietari = datiIniziali.Proprietari;
        manutenzioni = datiIniziali.Manutenzioni;
    }

    private async Task MostraDettaglio(Proprietario p)
    {
        var parameters = new DialogParameters { ["Proprietario"] = p };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<ProprietarioDetailDialog>("Dettaglio Proprietario", parameters, options);
    }


    /* ---------- ELIMINAZIONE DELLA MANUTENZIONE ---------- */
    private async Task ConfermaEliminazioneProprietarioAsync(Proprietario proprietario)
    {
        var parameters = new DialogParameters
        {
            ["Parameters"] = new Dictionary<string, object>
                {
                    { "Nome", proprietario.Nome },
                    { "Cognome", proprietario.Cognome }
                }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };

        IDialogReference dialog = await DialogService.ShowAsync<ConfermaEliminazioneDialog>("Conferma eliminazione", parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            await RepositoryManager.For<Proprietario>().DeleteAsync(proprietario.Id);
            await OnInitializedAsync();
        }
    }
}
