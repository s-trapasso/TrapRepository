@page "/veicoli"
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject NavigationManager Nav
@inject ILoggingService<Veicoli> Log
@inject IDialogService DialogService

<MudPaper Class="page-container">
    <div class="page-header">
        <MudText Typo="Typo.h5">Elenco veicoli</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Nav.NavigateTo("/veicoli/nuovo"))">
            Nuovo veicolo
        </MudButton>
    </div>

    @if (veicoli == null)
    {
        <div class="page-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body1">Caricamento...</MudText>
        </div>
    }
    else if (!veicoli.Any())
    {
        <MudAlert Severity="Severity.Info" Elevation="0" Class="page-alert">
            Nessun veicolo registrato.
        </MudAlert>
    }
    else
    {
        <MudTable Items="veicoli" Hover="true" Dense="true" Striped="true" Class="page-table">
            <HeaderContent>
                <MudTh>Targa</MudTh>
                <MudTh>Marca</MudTh>
                <MudTh>Modello</MudTh>
                <MudTh>Anno</MudTh>
                <MudTh>Alimentazione</MudTh>
                <MudTh>Chilometri</MudTh>
                <MudTh>Intestatario</MudTh>
                <MudTh>Azioni</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Targa">@context.Targa</MudTd>
                <MudTd DataLabel="Marca">@context.Marca</MudTd>
                <MudTd DataLabel="Modello">@context.Modello</MudTd>
                <MudTd DataLabel="Anno">@context.Anno</MudTd>
                <MudTd DataLabel="Alimentazione">@context.Alimentazione</MudTd>
                <MudTd DataLabel="Km">@context.Km</MudTd>
                <MudTd DataLabel="Intestatario">@context.Proprietario?.Nome @context.Proprietario?.Cognome</MudTd>
                <MudTd>
                    <ActionButtons OnEdit="@(() => Nav.NavigateTo($"/veicoli/edit/{context.Id}"))"
                                   OnDelete="@(() => ConfermaEliminazioneAsync(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<Veicolo>? veicoli = new();
    private List<Proprietario>? proprietari;
    private List<Manutenzione>? manutenzioni;

    private Veicolo? veicoloSelezionato;

    protected override async Task OnInitializedAsync()
    {
        var datiIniziali = await RepositoryManager.CaricaDatiInizialiAsync();
        veicoli = datiIniziali.Veicoli;
        proprietari = datiIniziali.Proprietari;
        manutenzioni = datiIniziali.Manutenzioni;
    }

    /* ---------- ELIMINAZIONE DEL VEICOLO ---------- */
    private async Task ConfermaEliminazioneAsync(Veicolo veicolo)
    {
        var parameters = new DialogParameters
        {
            ["Parameters"] = new Dictionary<string, object>
            {
                { "Targa", veicolo.Targa }
            }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<ConfermaEliminazioneDialog>("Conferma eliminazione", parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            await RepositoryManager.For<Veicolo>().DeleteAsync(veicolo.Id);
            await OnInitializedAsync();
        }
    }
}
