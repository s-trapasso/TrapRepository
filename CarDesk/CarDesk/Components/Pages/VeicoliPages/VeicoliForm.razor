@using CarDesk.Components.Pages.ProprietariPages
@using CarDesk.Data.Models
@using CarDesk.Data.Models.Enum
@using CarDesk.Data.Services.Interfaces
@inject IRepositoryManager RepositoryManager
@inject ILoggingService<VeicoliForm> Log
@inject IDialogService DialogService

<div class="page-form">
    <div class="form-header">Dettagli Veicolo</div>
    <MudForm Model="Veicolo" @ref="formVeicolo" @bind-IsValid="formIsValid">
        <MudTextField Label="Targa" @bind-Value="Veicolo.Targa" Required="true" For="@(() => Veicolo.Targa)" />
        <MudTextField Label="Marca" @bind-Value="Veicolo.Marca" Required="true" For="@(() => Veicolo.Marca)" />
        <MudTextField Label="Modello" @bind-Value="Veicolo.Modello" Required="true" For="@(() => Veicolo.Modello)" />
        <MudNumericField T="int" Label="Anno" @bind-Value="Veicolo.Anno" Required="true" Min="1990" Max="@DateTime.Now.Year" For="@(() => Veicolo.Anno)" />
        <MudSelect T="AlimentazioneEnum?" Label="Alimentazione" @bind-Value="Veicolo.Alimentazione" Required="true" For="@(() => Veicolo.Alimentazione)" Clearable="true">
            @foreach (var tipo in Enum.GetValues<AlimentazioneEnum>())
            {
                <MudSelectItem T="AlimentazioneEnum?" Value="tipo">@tipo</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField Label="Chilometraggio" @bind-Value="Veicolo.Km" Required="true" For="@(() => Veicolo.Km)" Min="0" />
        <!-- === PROPRIETARIO ==================================================== -->
        <MudSelect T="int" Label="Proprietario" Value="ProprietarioIdSelezionato" Required="true" For="@(() => Veicolo.ProprietarioId)" ValueChanged="OnProprietarioChanged" ValueExpression="@(() => ProprietarioIdSelezionato)">
            <MudSelectItem Value="-1">-- Seleziona --</MudSelectItem>
            @foreach (var p in proprietari)
            {
                <MudSelectItem Value="@p.Id">@p.Nome @p.Cognome</MudSelectItem>
            }
            <MudSelectItem Value="0">Nuovo proprietario</MudSelectItem>
        </MudSelect>
        <MudStack Direction="Row" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Button" OnClick="() => SalvaAsync()">Salva</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" ButtonType="ButtonType.Button" OnClick="() => OnAnnulla.InvokeAsync()">Annulla</MudButton>
            @if (Veicolo.Id != 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" Class="ms-auto" ButtonType="ButtonType.Button" OnClick="() => ConfermaEliminazioneDaFormAsync(Veicolo)">Elimina Veicolo</MudButton>
            }
        </MudStack>
    </MudForm>
</div>
@code {
    /* ---------- PARAMETRI DAL PADRE -------------------------- */
    [Parameter] public Veicolo Veicolo { get; set; } = new();
    [Parameter] public EventCallback OnSalvato { get; set; }
    [Parameter] public EventCallback OnAnnulla { get; set; }

    /* ---------- DATI DI SUPPORTO ----------------------------- */
    private List<Proprietario> proprietari = new();
    private bool isNuovoProprietario;
    private Proprietario nuovoProprietario = new();
    MudForm formVeicolo;
    bool formIsValid;

    /* ---------- CICLO VITA ----------------------------------- */
    protected override async Task OnInitializedAsync()
    {
        proprietari = await RepositoryManager.For<Proprietario>().GetAllAsync();
        ProprietarioIdSelezionato = Veicolo.ProprietarioId > 0 ? Veicolo.ProprietarioId : -1;
    }
    private async Task OnProprietarioChanged(int id)
    {
        if (id == 0)
        {
            await ApriDialogNewProprietarioAsync();
        }
        else
        {
            ProprietarioIdSelezionato = id;
        }
    }
   
    // ---- proprietà wrapper ----
    private int ProprietarioIdSelezionatoBacking = -1;
    private int ProprietarioIdSelezionato
    {
        get => ProprietarioIdSelezionatoBacking;
        set
        {
            ProprietarioIdSelezionatoBacking = value;

            if (value == 0)                      // “Nuovo proprietario”
            {
                // isNuovoProprietario = true;
                _ = ApriDialogNewProprietarioAsync(); // apre il dialog per creare un nuovo proprietario
                // Veicolo.ProprietarioId = 0;
            }
            else if (value > 0)                  // proprietario esistente selezionato
            {
                isNuovoProprietario = false;
                Veicolo.ProprietarioId = value;
            }
            else                                 // Nessuno selezionato
            {
                isNuovoProprietario = false;
                Veicolo.ProprietarioId = -1;
            }
        }
    }
    /* ---------- SALVATAGGIO VEICOLO -------------------------- */
    async Task SalvaAsync()
    {
        
        try
        {
            await formVeicolo.Validate();
            if (formIsValid)
            {
                if (Veicolo.Id == 0)
                    await RepositoryManager.For<Veicolo>().AddAsync(Veicolo);
                else
                    await RepositoryManager.For<Veicolo>().UpdateAsync(Veicolo);

                Log.LogInformation("Salvato veicolo {Targa}", Veicolo.Targa);
                await OnSalvato.InvokeAsync();
            }
            
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Errore salvataggio veicolo {Targa}", Veicolo.Targa);
        }
    }

    /* ---------- ELIMINAZIONE DEL VEICOLO ---------- */
    private async Task ConfermaEliminazioneDaFormAsync(Veicolo veicolo)
    {
        var parameters = new DialogParameters
        {
            ["Parameters"] = new Dictionary<string, object>
                {
                    {"Targa",veicolo.Targa}
                }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };

        IDialogReference dialog = await DialogService.ShowAsync<ConfermaEliminazioneDialog>("Conferma eliminazione", parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await RepositoryManager.For<Veicolo>().DeleteAsync(veicolo.Id);
                Log.LogInformation("Veicolo eliminato: {Targa}", veicolo.Targa);
                await OnAnnulla.InvokeAsync(); // torna alla lista dopo l'eliminazione
            }
            catch (Exception ex)
            {
                Log.LogError(ex, "Errore durante l'eliminazione del veicolo {Targa}", veicolo.Targa);
                // potresti mostrare un messaggio all'utente
            }
        }
    }

    //---DIALOG PER CREAZIONE NUOVO PROPRIETARIO---//
    async Task ApriDialogNewProprietarioAsync()
    {
        var parameters = new DialogParameters
        {
            ["Proprietario"] = new Proprietario()
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<NewProprietarioDialog>("Nuovo Proprietario", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Proprietario nuovo)
        {
            // Ricarica la lista e aggiorna il veicolo
            proprietari = await RepositoryManager.For<Proprietario>().GetAllAsync();
            Veicolo.ProprietarioId = nuovo.Id;
            ProprietarioIdSelezionato = nuovo.Id;
        }
    }
}
