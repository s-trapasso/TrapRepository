@page "/proprietari"
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject NavigationManager Nav

<h3>Elenco Proprietari</h3>

<button class="btn btn-primary" @onclick="@(()=> Nav.NavigateTo("/proprietari/nuovo"))">Nuovo Proprietario</button>  


@if (proprietari == null)
{
    <p><em>Caricamento...</em></p>
}
else if (proprietari.Count == 0)
{
    <div class="alert alert-info">
        Nessun proprietario trovato.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Cognome</th>
                <th>Indirizzo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in proprietari)
            {
                <tr>
                    <td>@p.Nome</td>
                    <td>@p.Cognome</td>
                    <td>@p.Indirizzo</td>
                    <td>
                        <button class="btn btn-primary"
                                @onclick='() => Nav.NavigateTo($"/proprietari/edit/{p.Id}")'>
                            Modifica
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CarDesk.Data.Models.Veicolo>? veicoli;
    private List<CarDesk.Data.Models.Proprietario>? proprietari;
    private List<CarDesk.Data.Models.Manutenzione>? manutenzioni;

    protected override async Task OnInitializedAsync()
    {
        var (veicoliCaricati, proprietariCaricati, manutenzioniCaricate) = await RepositoryManager.CaricaDatiInizialiAsync();

        veicoli = veicoliCaricati;
        proprietari = proprietariCaricati;
        manutenzioni = manutenzioniCaricate;
    }
}
