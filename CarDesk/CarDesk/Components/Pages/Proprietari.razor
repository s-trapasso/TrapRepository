@page "/proprietari"
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject NavigationManager Nav
@inject ILoggingService<Proprietari> Log

<h3>Elenco Proprietari</h3>

<button class="btn btn-primary" @onclick="@(()=> Nav.NavigateTo("/proprietari/nuovo"))">Nuovo Proprietario</button>  


@if (proprietari == null)
{
    <p><em>Caricamento...</em></p>
}
else if (proprietari.Count == 0)
{
    <div class="alert alert-info">
        Nessun proprietario trovato.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Cognome</th>
                <th>Indirizzo</th>
                <th></th> @* Modifica *@
                <th></th> @* Elimina *@
            </tr>
        </thead>
        <tbody>
            @foreach (var p in proprietari)
            {
                <tr>
                    <td>@p.Nome</td>
                    <td>@p.Cognome</td>
                    <td>@p.Indirizzo</td>
                    <td>
                        <button class="btn btn-primary"
                                @onclick='() => Nav.NavigateTo($"/proprietari/edit/{p.Id}")'>
                            Modifica
                        </button>
                    </td>
                    <td>
                        <MudButton Color="Color.Error"
                                   Variant="Variant.Filled"
                                   OnClick="() => MostraConfermaElimina(p)">
                            Elimina Proprietario
                        </MudButton>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@* =========== MODAL UNICO =========== *@
@if (confermaElimina && proprietarioSelezionato is not null)
{
    <div class="modal fade show d-block" style="background:#00000080;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Conferma eliminazione</h5>
                </div>
                <div class="modal-body">
                    Vuoi davvero eliminare<strong>@proprietarioSelezionato.Nome @proprietarioSelezionato.Cognome</strong>?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ChiudiModal">Annulla</button>
                    <button class="btn btn-danger" @onclick="EliminaAsync">Elimina</button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private List<Veicolo>? veicoli;
    private List<Proprietario>? proprietari;
    private List<Manutenzione>? manutenzioni;
    private bool confermaElimina;
    private Proprietario? proprietarioSelezionato;


    protected override async Task OnInitializedAsync()
    {
        var datiIniziali = await RepositoryManager.CaricaDatiInizialiAsync();

        veicoli = datiIniziali.Veicoli;
        proprietari = datiIniziali.Proprietari;
        manutenzioni = datiIniziali.Manutenzioni;
    }

    /* ---------- ELIMINAZIONE DELLA MANUTENZIONE ---------- */
    void MostraConfermaElimina(Proprietario proprietario)
    {
        proprietarioSelezionato = proprietario;
        confermaElimina = true;
    }
    void ChiudiModal()
    {
        confermaElimina = false;
        proprietarioSelezionato = null;
    }

    async Task EliminaAsync()
    {
        if (proprietarioSelezionato is null) return;

        try
        {
            await RepositoryManager.For<Proprietario>().DeleteAsync(proprietarioSelezionato.Id);
            proprietari.Remove(proprietarioSelezionato);
            Log.LogInformation("Eliminato proprietario {0}{1}", proprietarioSelezionato.Nome, proprietarioSelezionato.Cognome);
            confermaElimina = false;

        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Errore eliminazione proprietario {0}{1}", proprietarioSelezionato.Nome, proprietarioSelezionato.Cognome);
            confermaElimina = false;
        }
        finally
        {
            ChiudiModal();
        }
    }
}
