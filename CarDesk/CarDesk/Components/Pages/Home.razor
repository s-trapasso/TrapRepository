@page "/"
@using CarDesk.Data.Models.Weather
@using MudBlazor
@inject NavigationManager Navigation
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject CarDesk.Data.Services.OpenMeteoService MeteoService
@using CarDesk.Data.Models

<MudContainer Class="dashboard-container">

    <MudText Typo="Typo.h4" Class="dashboard-text-h4">Dashboard 30102025</MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mt-6" />
    }
    else
    {
        <!-- ALERT -->
        <MudGrid Class="dashboard-grid" Spacing="3">
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Elevation="0" Class="dashboard-alert">
                    Benvenuto in CarDesk! Questa dashboard ti offre una panoramica rapida dei veicoli, manutenzioni e proprietari registrati nel sistema.
                    Clicca sulle schede per esplorare i dettagli.
                </MudAlert>
            </MudItem>
        </MudGrid>

        <!-- KPI CARDS -->
        <div class="kpi-cards-wrapper">
            @foreach (var card in KpiCards)
            {
                <MudPaper Class="@($"kpi-card {card.CssClass}")" Elevation="6" @onclick="@(() => NavigateToCard(card.Label))">
                    <MudIcon Icon="@card.Icon" Size="Size.Large" Color="@card.Color" />
                    <MudText Typo="Typo.body2" Class="mt-2">@card.Label</MudText>
                    <MudText Typo="Typo.h3" Class="fw-bold">@card.Value</MudText>
                    @if (!string.IsNullOrEmpty(card.ExtraInfo))
                    {
                        <MudText Typo="Typo.caption">@card.ExtraInfo</MudText>
                    }
                </MudPaper>
            }
        </div>

        <!-- METEO -->
        @if (weather is not null)
        {
            <MudPaper Class="dashboard-weather" Elevation="6">
                <MudIcon Icon="@Icons.Material.Filled.WbSunny" Size="Size.Large" Color="Color.Warning" />
                <MudText Typo="Typo.body2" Class="mt-2">Meteo</MudText>
                <MudText Typo="Typo.h3" Class="fw-bold">@($"{weather.TemperatureC}°C")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@weather.Description</MudText>
            </MudPaper>
        }

        <!-- CHART -->
        <MudPaper Class="dashboard-chart" Elevation="6">
            <MudText Typo="Typo.h6" GutterBottom="true">Costo manutenzioni (anno corrente @DateTime.Now.Year)</MudText>
            <MudChart ChartType="ChartType.Line"
                      ChartSeries="@Series"
                      XAxisLabels="@XAxisLabels"
                      ChartOptions="options"
                      Width="100%"
                      Height="350" />
        </MudPaper>
    }
</MudContainer>


@code {
    class KpiCard
    {
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
        public string Icon { get; set; } = "";
        public Color Color { get; set; }
        public string? ExtraInfo { get; set; }
        public string CssClass { get; set; } = "";
    }

    private bool isLoading = true;
    private List<KpiCard> KpiCards = new();
    private WeatherInfo? weather;
    private List<Veicolo>? veicoli;
    private List<Proprietario>? proprietari;
    private List<Manutenzione>? manutenzioni;
    private List<Scadenza>? scadenze;

    private List<ChartSeries> Series = new();
    private string[] XAxisLabels = Array.Empty<string>();
    private ChartOptions options = new ChartOptions();

    protected override async Task OnInitializedAsync()
    {
        await CaricaDatiAsync();
        CreaKpiCards();
        PreparaChart();
        isLoading = false;
    }

    private async Task CaricaDatiAsync()
    {
        var datiIniziali = await RepositoryManager.CaricaDatiInizialiAsync();
        veicoli = datiIniziali.Veicoli;
        proprietari = datiIniziali.Proprietari;
        manutenzioni = datiIniziali.Manutenzioni;
        //scadenze = datiIniziali.Scadenze;
    }

    private void CreaKpiCards()
    {
        var prossimi30 = manutenzioni?.Count(x => x.Data <= DateTime.Today.AddDays(30)) ?? 0;

        KpiCards = new()
        {
            new KpiCard { Label = "Veicoli Totali", Value = (veicoli?.Count ?? 0).ToString(), Icon  = Icons.Material.Filled.DirectionsCar, CssClass = "veicoli"/*, ExtraInfo = "Numero complessivo di veicoli registrati"*/ },
            new KpiCard { Label = "Interventi", Value = prossimi30.ToString(), Icon  = Icons.Material.Filled.Schedule, CssClass = "interventi" /*, ExtraInfo = "Manutenzioni entro i prossimi 30 giorni" */},
            new KpiCard { Label = "Proprietari Censiti", Value = (proprietari?.Count ?? 0).ToString(), Icon  = Icons.Material.Filled.Person, CssClass = "proprietari"/*, ExtraInfo = "Totale proprietari registrati" */}
            //new KpiCard { Label = "Scadenze", Value = (scadenze?.Count ?? 0).ToString(), Icon  = Icons.Material.Filled.Alarm, CssClass = "scadenze"/*, ExtraInfo = "Riepilogo scadenze registrate" */}
        };
    }

    private void PreparaChart()
    {
        options.InterpolationOption = InterpolationOption.Straight;
        options.YAxisFormat = "c2";

        int year = DateTime.Today.Year;
        var manutenzioniByVeicolo = manutenzioni?
            .Where(m => m.Data.Year == year)
            .GroupBy(m => m.VeicoloId)
            .ToList() ?? new();

        foreach (var gruppo in manutenzioniByVeicolo)
        {
            var byMonth = gruppo
                          .GroupBy(m => m.Data.Month)
                          .ToDictionary(g => g.Key, g => g.Sum(x => (double)x.Costo));

            var data = Enumerable.Range(1, 12)
                       .Select(m => byMonth.ContainsKey(m) ? byMonth[m] : 0d)
                       .ToArray();

            var nomeVeicolo = gruppo.First().Veicolo?.Modello ?? $"Veicolo {gruppo.Key}";
            Series.Add(new ChartSeries { Name = nomeVeicolo, Data = data });
        }
    }

    private void NavigateToCard(string label)
    {
        switch (label)
        {
            case "Veicoli Totali": Navigation.NavigateTo("/veicoli"); break;
            case "Interventi": Navigation.NavigateTo("/manutenzioni"); break;
            case "Proprietari Censiti": Navigation.NavigateTo("/proprietari"); break;
           // case "Scadenze": Navigation.NavigateTo("/scadenze"); break;
        }
    }
}
