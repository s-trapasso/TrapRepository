@page "/"
@using MudBlazor
@inject NavigationManager Navigation
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@using CarDesk.Data.Models

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    @* ====== LOADING ====== *@
    @if (isLoading)
    {
        <MudStack  JustifyContent="Center" Class="mt-6">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.subtitle2" Class="mt-2">Caricamento dati…</MudText>
        </MudStack>
    }
    else
    {
        @* ====== KPI CARDS ====== *@
        <MudGrid Spacing="3" Justify="Justify.Center" AlignItems="Align.Center">
            @foreach (var card in KpiCards)
            {
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Elevation="6"
                              Rounded="true"
                              Class="pa-4 hover-lift kpi-card"
                              Style="min-height:160px; cursor:pointer;"
                              @onclick="() => NavigateToCard(card.Label)">
                        <MudStack Spacing="1" JustifyContent="Center">
                            <MudAvatar Icon="@card.Icon" Size="Size.Large" Color="@card.Color" />
                            <MudText Typo="Typo.h4" Class="mt-2">@card.Value</MudText>
                            <MudText Typo="Typo.subtitle2">@card.Label</MudText>

                            @if (!string.IsNullOrEmpty(card.ExtraInfo))
                            {
                                <MudTooltip Text="@card.ExtraInfo">
                                    <MudBadge Content="'i'" Color="Color.Secondary" Class="mt-1" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @* ====== CHART ====== *@
        @* <MudPaper Class="pa-4 mt-6" Elevation="6" Rounded="true">
            <MudText Typo="Typo.h6" Class="mb-2">Costo manutenzioni (ultimi 6 mesi)</MudText>
            <MudChart ChartType="ChartType.Bar"
                      Labels="@CostLabels"
                      Datasets="@CostDatasets"
                      Animate="true" />
        </MudPaper> *@
    }
</MudContainer>

<style>
    .hover-lift {
        transition: transform .2s ease-in-out;
    }

        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0,0,0,.15);
        }

    .kpi-card {
        transition: background .3s ease;
    }

        .kpi-card:hover {
            background: rgba(0,0,0,.03);
        }
</style>

@code {
    /* ---------- MODELLI ---------- */
