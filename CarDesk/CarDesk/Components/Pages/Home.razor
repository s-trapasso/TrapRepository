                ExtraInfo = "Numero complessivo di veicoli registrati"
            },
            new KpiCard
            {
                Label = "Interventi Imminenti",
                Value = prossimi30.ToString(),
                Icon  = Icons.Material.Filled.Schedule,
                Color = Color.Warning,
                ExtraInfo = "Manutenzioni entro i prossimi 30 giorni"
            },
            new KpiCard
            {
                Label = "Proprietari Censiti",
                Value = (proprietari?.Count ?? 0).ToString(),
                Icon  = Icons.Material.Filled.Person,
                Color = Color.Success,
                ExtraInfo = "Totale proprietari registrati"
