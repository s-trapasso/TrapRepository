@page "/veicoli/nuovo"
@page "/veicoli/edit/{Id:int}"
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject NavigationManager Nav
@namespace CarDesk.Components.Forms

<h3>VeicoliEdit Page</h3>

<VeicoliForm Veicolo="model" OnSalvato="RitornaAllaLista" OnAnnulla="RitornaAllaLista" @key="model.Id"></VeicoliForm>

@code {
    [Parameter] public int? Id { get; set; }
    private Veicolo model = new();     // nuovo per default

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)               // modalità modifica
            model = await RepositoryManager.For<Veicolo>().GetByIdAsync(Id.Value) ?? new Veicolo();
    }

    Task RitornaAllaLista()
    {
        Nav.NavigateTo("/veicoli", true);
        return Task.CompletedTask;
    }
}