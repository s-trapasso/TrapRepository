@using CarDesk.Data.Models
@using CarDesk.Data.Services.Interfaces
@using CarDesk.Data.Models.Enum
@inject IRepositoryManager RepositoryManager
@inject ILoggingService<ManutenzioniForm> Log
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IErrorHandlerService ErrorHandler

<MudForm Model="Manutenzione" @ref="formManutenzione">
	<MudPaper Class="pa-4" Elevation="1">
	<!-- === CAMPI MANUTENZIONE =================================================== -->
	@* Mostra i dettagli del veicolo selezionato, solo se presente *@
	<!-- Targa veicolo -->
	@if (VeicoloCorrente is not null)
	{
		<MudTextField T="string" Label="Targa selezionata" Value="@VeicoloCorrente.Targa" ReadOnly="true" />
	}

	<MudDatePicker Label="Data intervento" 
				   Required="true"
				   DateFormat="dd-MM-yyyy" 
				   ShowToolbar="true" 
				   PickerVariant="PickerVariant.Inline" Class="mb-4"
				   @bind-Date="DataInteventoSelezionata">
	</MudDatePicker>	

	<MudText Typo="Typo.h6" Class="mt-4 mb-2">Voci Intervento</MudText>

	<MudTable Items="Manutenzione.VociIntervento" Dense="true" Hover="true" Elevation="0">
		<HeaderContent>
			<MudTh>Descrizione</MudTh>
			<MudTh>Prezzo (€)</MudTh>
		</HeaderContent>
		<RowTemplate Context="voce">
    <MudTd>
        <MudSlideTransition>
            @if (voce.TipoIntervento == TipoInterventoEnum.AltraVoce)
            {
                <MudStack>
                    <MudTextField T="string"
                                  Label="Descrizione personalizzata"
                                  @bind-Value="voce.Descrizione"
                                  Dense="true"
                                  Placeholder="Inserisci descrizione" />

                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               Class="mt-1"
                               OnClick="@(() => voce.TipoIntervento = null)">
                        Torna alla selezione standard
                    </MudButton>
                </MudStack>
            }
            else
            {
                <MudStack>
                    <MudSelect T="TipoInterventoEnum?" Label="Tipo intervento"
                               @bind-Value="voce.TipoIntervento"
                               Clearable="true"
                               Dense="true">

                        @foreach (var tipo in Enum.GetValues<TipoInterventoEnum>()
                                                 .OrderBy(t => t.GetDisplayName()))
                        {
                            <MudSelectItem T="TipoInterventoEnum?" Value="tipo">@tipo.GetDisplayName()</MudSelectItem>
                        }
                    </MudSelect>

                    <MudText Typo="Typo.caption" Class="mt-1 text-secondary">
                        Oppure seleziona "Altra voce" per una descrizione personalizzata
                    </MudText>
                </MudStack>
            }
        </MudSlideTransition>
    </MudTd>

    <MudTd>
        <MudTextField T="decimal?" @bind-Value="voce.Costo"
                      Immediate="true"
                      Placeholder="€"
                      Dense="true"
                      Adornment="Adornment.End"
                      AdornmentText="€" />
    </MudTd>

    <MudTd Class="text-end">
        <MudButton Color="Color.Error"
                   Size="Size.Small"
                   OnClick="() => ConfermaEliminazioneVoceAsync(voce)">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="me-1" /> Elimina voce
        </MudButton>
    </MudTd>
</RowTemplate>
	</MudTable>
		<!-- da controllare formManutenzione.IsValid -->
	<MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" 
				OnClick="AggiungiVoce">
				Aggiungi Voce Intervento
	</MudButton>
	<!-- Bottoni -->
		<MudDivider Class="my-4" />
		<MudStack Direction="Row" Spacing="2">
			<MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Button"
					   Disabled="@(!formManutenzione.IsValid || Manutenzione.VeicoloId <=0 || !VoceInterventoValida || !PrimaVoceValida)" OnClick="() => SalvaAsync()">
				Salva voce
			</MudButton>
			
			<MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => OnAnnulla.InvokeAsync()">
				Annulla
			</MudButton>
		</MudStack>
		<MudDialog>
			<DialogContent>
				<MudText Typo="Typo.h6">@Message</MudText>
			</DialogContent>
			<DialogActions>
				<MudButton OnClick="() => MudDialog.Cancel()" Color="Color.Default">Annulla</MudButton>
				<MudButton OnClick="() => MudDialog.Close(DialogResult.Ok(true))" Color="Color.Error">Conferma</MudButton>
			</DialogActions>
		</MudDialog>
	</MudPaper>
</MudForm>


@code {
	/* ---------- PARAMETRI DAL PADRE -------------------------- */
	[Parameter] public Manutenzione Manutenzione { get; set; } = new();
	[Parameter] public Veicolo? Veicolo { get; set; } = new();
	[Parameter] public EventCallback OnSalvato { get; set; }
	[Parameter] public EventCallback OnAnnulla { get; set; }
	[Parameter] public int? SelectedVehicleId { get; set; }   // <— nuovo
	[Parameter] public List<VoceIntervento> listaVoceIntervento { get; set; }
	[Parameter] public string Message { get; set; }
	[CascadingParameter] IMudDialogInstance MudDialog { get; set; }
	MudForm formManutenzione;
	
	/* ---------- DATI DI SUPPORTO ----------------------------- */
	private List<Veicolo> veicoli = new();

	void Conferma() => MudDialog.Close(DialogResult.Ok(true));
	void Annulla() => MudDialog.Cancel();

	private bool PrimaVoceValida =>	Manutenzione.VociIntervento.FirstOrDefault() is { } prima &&
									!string.IsNullOrWhiteSpace(prima.Descrizione) &&
									prima.Costo.HasValue &&
									prima.Costo.Value > 0;
	private bool VoceInterventoValida => Manutenzione.VociIntervento != null && Manutenzione.VociIntervento.Count > 0 && Manutenzione.VociIntervento.All(v => !string.IsNullOrWhiteSpace(v.Descrizione) && v.Costo.HasValue && v.Costo.Value > 0);
	// === Proprietà calcolata: veicolo attualmente selezionato ===
	private Veicolo? VeicoloCorrente => veicoli.FirstOrDefault(v => v.Id == Manutenzione.VeicoloId);

	private DateTime? DataInteventoSelezionata
	{
		get => Manutenzione.Data;
		set => Manutenzione.Data = value ?? DateTime.Today; // se null, imposta oggi
	}
	/* ---------- CICLO VITA ----------------------------------- */
	protected override async Task OnInitializedAsync()
	{
		veicoli = await RepositoryManager.For<Veicolo>().GetAllAsync();		
		if(Manutenzione.VociIntervento == null)
		{
			Manutenzione.VociIntervento = new List<VoceIntervento>();
		}
		// Se ci sono voci salvate, inizializza TipoIntervento da Descrizione
		foreach (var voce in Manutenzione.VociIntervento)
		{
			voce.InitializeTipoInterventoFromDescrizione();
		}
		if (Manutenzione.VociIntervento.Count == 0)
		{
			Manutenzione.VociIntervento.Add(new VoceIntervento{Costo = 0});
		}
		// Se è una nuova manutenzione, inizializza la data a oggi (può essere modificata dall'utente)
		if (Manutenzione.Id == 0)
			Manutenzione.Data = DateTime.Today;
	}
	protected override void OnParametersSet()
	{
		if (Manutenzione.Id == 0       // solo record nuovo
			&& SelectedVehicleId is > 0)
		{
			Manutenzione.VeicoloId = SelectedVehicleId.Value;
		}
		// Inizializza la lista se è null
		if (Manutenzione.VociIntervento == null)
		{
			Manutenzione.VociIntervento = new List<VoceIntervento>();
		}
	}
	/* ---------- GESTIONE VOCI INTERVENTO --------------------- */
	void AggiungiVoce()
	{
		Manutenzione.VociIntervento.Add(new VoceIntervento());
	}

	async Task RimuoviVoceAsync(VoceIntervento voce)
	{
		if (voce.Id > 0)
		{	
			// Chiamata al repository per eliminare dal DB
			await RepositoryManager.For<VoceIntervento>().DeleteAsync(voce.Id);
			Manutenzione.VociIntervento.Remove(voce);
			if(Manutenzione.VociIntervento.Count == 0)
			{
				await RepositoryManager.For<Manutenzione>().DeleteAsync(Manutenzione.Id);
				await OnSalvato.InvokeAsync();
			}
		}
	}
	/* ---------- SALVATAGGIO MANUTENZIONE -------------------------- */
	async Task SalvaAsync()
	{
		try
		{
			// Calcola il costo totale
			Manutenzione.Costo = Manutenzione.VociIntervento.Sum(v => v.Costo ?? 0);

			if (Manutenzione.Id == 0)
				await RepositoryManager.For<Manutenzione>().AddAsync(Manutenzione);
			else
				await RepositoryManager.For<Manutenzione>().UpdateAsync(Manutenzione);

			Log.LogInformation("Salvato intervento riferito al veicolo {0}", VeicoloCorrente?.Targa);
			await OnSalvato.InvokeAsync();
		}
		catch (Exception ex)
		{
			await ErrorHandler.HandleAsync(ex, $"Errore salvataggio veicolo {VeicoloCorrente?.Targa}");
			Log.LogError(ex, "Errore salvataggio intervento riferito al veicolo {0}", VeicoloCorrente?.Targa);
		}
	}

	// ---- veicolo wrapper ----
	private int _veicoloSelezionato = -1;
	private int VeicoloIdSelezionato
	{
		get => _veicoloSelezionato;
		set
		{
			_veicoloSelezionato = value;
			Manutenzione.VeicoloId = value;
			if(value == 0)
			{
				Nav.NavigateTo("/veicoli/nuovo", true);
			}

		}
	}
	// async Task MostraConfermaElimina()
	// {
	// 	var parameters = new DialogParameters
	// 	{
	// 		["Message"] = $"Vuoi davvero eliminare tutte le voci per il veicolo {VeicoloCorrente?.Targa}?"
	// 	};

	// 	IDialogReference dialog = await DialogService.ShowAsync<ConfermaEliminazioneDialog>("Conferma eliminazione", parameters);
	// 	var result = await dialog.Result;

	// 	if (!result.Canceled)
	// 	{
	// 		await EliminaAsync();
	// 	}
	// }
	/* ---------- ELIMINAZIONE DEL VEICOLO ---------- */
	private async Task ConfermaEliminazioneVoceAsync(VoceIntervento voce)
	{
		var parameters = new DialogParameters
		{
			["Parameters"] = new Dictionary<string, object>
			{
				{"Id",voce.Id}
			}
			
		};
		var options = new DialogOptions { CloseOnEscapeKey = true };
		var dialog = await DialogService.ShowAsync<ConfermaEliminazioneDialog>("Conferma eliminazione", parameters,options);
		var result = await dialog.Result;

		if (!result.Canceled)
		{
			await RimuoviVoceAsync(voce);
		}
	}
}
