@page "/manutenzioni"
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject NavigationManager Nav
@inject ILoggingService<Manutenzione> Log
@inject IDialogService DialogService

<MudPaper Class="pa-4">
    @if(veicoli?.Count > 0)
    {
        <MudStack Spacing="2">
            <MudSelect T="int" Label="Veicolo" @bind-Value="VeicoloIdSelezionato" Dense="true">
                <MudSelectItem Value="-1">-- Seleziona veicolo --</MudSelectItem>
                @foreach (var v in veicoli)
                {
                    <MudSelectItem value="@v.Id">@v.Targa (@v.Marca @v.Modello)</MudSelectItem>
                }
                <MudSelectItem Value="0">Nuovo veicolo…</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled" Disabled="@(veicoli?.Count == 0 || VeicoloIdSelezionatoBacking <= 0)"
                       OnClick="@(() => Nav.NavigateTo($"/manutenzioni/nuovo/{VeicoloIdSelezionatoBacking}"))">
                Nuovo intervento
            </MudButton>
        </MudStack>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Nessun veicolo registrato. <MudLink Href="/veicoli/nuovo"><b>Aggiungine uno</b></MudLink>
            per poter inserire una manutenzione.
        </MudAlert>
    }
    <MudDivider Class="my-4" />
    <!-- === Elenco manutenzioni filtrato ================================ -->
    @if (manutenzioniFiltrate is null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary">Caricamento...</MudProgressCircular>
    }
    else if (VeicoloIdSelezionatoBacking > 0 && manutenzioniFiltrate.Count == 0)
    {
        <MudText>Nessun intervento trovato per il veicolo selezionato</MudText>
    }
    else if (manutenzioniFiltrate.Count > 0)
    {
        <MudText Typo ="Typo.h5" Class="mb-2">Elenco Interventi di manutenzione</MudText>
        <MudTable Items="manutenzioniFiltrate" Hover="true">
            <HeaderContent>
                <MudTh>Data intervento</MudTh>
                <MudTh>Targa del veicolo</MudTh>
                <MudTh>Costo Totale (€)</MudTh>
                <MudTh>Azioni</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Data.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@context.Veicolo?.Targa</MudTd>
                <MudTd>@context.CostoTotale</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="() => GoToModifica(context.Id)" StartIcon="@Icons.Material.Filled.Edit"></MudButton>
                    <MudButton Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="() => ConfermaEliminazioneAsync(context)">                        
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>
@code {

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /* ------- dati caricati all’avvio -------------------- */
    private List<Veicolo>? veicoli;
    private List<Proprietario>? proprietari;
    private List<Manutenzione>? manutenzioni;

    /* ---------- DATI DI SUPPORTO ----------------------------- */
    private List<Manutenzione>? manutenzioniFiltrate;
    private int VeicoloSelezionato = -1;
    private Manutenzione? manutenzioneSelezionata;
    private bool confermaElimina;

    protected override async Task OnInitializedAsync()
    {
        var datiIniziali = await RepositoryManager.CaricaDatiInizialiAsync();

        veicoli = datiIniziali.Veicoli;
        proprietari = datiIniziali.Proprietari;
        manutenzioni = datiIniziali.Manutenzioni
                                    .Select(m =>
                                    {
                                        m.VociIntervento = m.VociIntervento ?? [];
                                        return m;
                                    }).ToList();

        //Se esiste almeno un veicolo, seleziona il primo
        if (veicoli?.Count > 0)
        {
            VeicoloSelezionato = veicoli.First().Id;
            FiltraManutenzioni();
        }
        else
        {
            manutenzioniFiltrate = [];
        }
    }
    /* ------- cambia filtro quando l’utente sceglie un veicolo -------- */
    private int VeicoloIdSelezionatoBacking = -1;
    private int VeicoloIdSelezionato
    {
        get => VeicoloIdSelezionatoBacking;
        set
        {
            if (value == 0)
            {
                Nav.NavigateTo("/veicoli/nuovo");
                FiltraManutenzioni();
                StateHasChanged();
            }
            else
            {
                VeicoloIdSelezionatoBacking = value;
                FiltraManutenzioni();
            }
        }
    }
    private void FiltraManutenzioni()
    {
        if(VeicoloIdSelezionatoBacking <= 0 || manutenzioni is null)
        {
            manutenzioniFiltrate = manutenzioni ?? [];
        }
        else
        {
            manutenzioniFiltrate = manutenzioni.Where(m => m.VeicoloId == VeicoloIdSelezionatoBacking).ToList();
        }
    }
    /* ---------- MODIFICA DELLA MANUTENZIONE ---------- */
    void GoToModifica(int manutenzioneId)
    {
        Nav.NavigateTo($"/manutenzioni/edit/{manutenzioneId}");
    }
    private async Task ConfermaEliminazioneAsync(Manutenzione m)
    {
        var parameters = new DialogParameters
        {
            ["Parameters"] = new Dictionary<string, object>
                {
                    {"Id",m.Id}
                }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };

        IDialogReference dialog = await DialogService.ShowAsync<ConfermaEliminazioneDialog>("Conferma eliminazione", parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            await RepositoryManager.For<Manutenzione>().DeleteAsync(m.Id);
            await OnInitializedAsync();
        }
    }
   
}
