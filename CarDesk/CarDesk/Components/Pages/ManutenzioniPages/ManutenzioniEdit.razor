@page "/manutenzioni/nuovo/{vehicleId:int?}"
@page "/manutenzioni/edit/{Id:int}"
@inject CarDesk.Data.Services.Interfaces.IRepositoryManager RepositoryManager
@inject NavigationManager Nav

<ManutenzioniForm Manutenzione="model" SelectedVehicleId="vehicleId" OnSalvato="RitornaAllaLista" OnAnnulla="RitornaAllaLista" @key="model.Id"></ManutenzioniForm>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int? vehicleId { get; set; }
    private Manutenzione model = new();     // nuovo per default
    private bool isNew => Id is null;

    protected override async Task OnInitializedAsync()
    {
        if (isNew)
        {
            model.Data = DateTime.Today;
            if(vehicleId > 0)
            {
                model.VeicoloId = vehicleId.Value; // se è un nuovo intervento, imposto il veicolo se passato come parametro
            }
        }
        else
        {
            model = await RepositoryManager.For<Manutenzione>().GetByIdAsync(Id.Value, query => query.Include(m => m.VociIntervento)) ?? new Manutenzione();
        }
    }

    Task RitornaAllaLista()
    {
        Nav.NavigateTo("/manutenzioni", true);
        return Task.CompletedTask;
    }
}
