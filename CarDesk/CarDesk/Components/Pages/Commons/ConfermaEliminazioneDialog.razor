<MudDialog>
    <DialogContent>
        <MudText>
            @if (Parameters != null)
            {
                if (Parameters.TryGetValue("Targa", out var targa))
                {
                    <span>Sei sicuro di voler eliminare il veicolo con targa <b>@targa</b>?</span>
                }
                else if (Parameters.TryGetValue("Nome", out var nome) && Parameters.TryGetValue("Cognome", out var cognome))
                {
                    <span>Sei sicuro di voler eliminare il proprietario <b>@nome @cognome</b>?</span>
                }
                else if (Parameters.TryGetValue("Id", out var id))
                {
                    <span>Sei sicuro di voler eliminare l'elemento con ID <b>@id</b>?</span>
                }
                else
                {
                    <span>Sei sicuro di voler procedere?</span>
                }
            }
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Error" OnClick="Submit">Elimina</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public IDictionary<string, object>? Parameters { get; set; }

    void Submit() => MudDialog.Close(DialogResult.Ok(true));
    void Cancel() => MudDialog.Cancel();
}
