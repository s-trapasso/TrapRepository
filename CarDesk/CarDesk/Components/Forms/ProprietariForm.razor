@using CarDesk.Data.Models
@using CarDesk.Data.Services.Interfaces
@inject IRepositoryManager Repo
@inject ILoggingService<ProprietariForm> Log

<EditForm Model="Proprietario" OnValidSubmit="SalvaAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-2">
        <label class="form-label">Nome</label>
        <InputText class="form-control" @bind-Value="Proprietario.Nome" />
    </div>

    <div class="mb-2">
        <label class="form-label">Cognome</label>
        <InputText class="form-control" @bind-Value="Proprietario.Cognome" />
    </div>

    <div class="mb-2">
        <label class="form-label">Cognome</label>
        <InputText class="form-control" @bind-Value="Proprietario.Indirizzo" />
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit"  class="btn btn-primary">Salva</button>
        <button type="button" class="btn btn-secondary" @onclick="() => OnAnnulla.InvokeAsync()">Annulla</button>
    </div>
</EditForm>

@code {
    [Parameter] public Proprietario Proprietario { get; set; } = new();
    [Parameter] public EventCallback<Proprietario> OnSalvato { get; set; }
    [Parameter] public EventCallback OnAnnulla { get; set; }

    async Task SalvaAsync()
    {
        try
        {
            await Repo.Proprietari.AddProprietarioAsync(Proprietario);
            Log.LogInformation("Creato proprietario {Nome} {Cognome}", Proprietario.Nome, Proprietario.Cognome);
            await OnSalvato.InvokeAsync(Proprietario);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Errore creazione proprietario");
        }
    }
}
