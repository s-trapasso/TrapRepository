@page "/scadenze"
@page "/scadenze/nuova"
@using VehicleManager.App.Services
@using VehicleManager.Shared.DTOs
@using VehicleManager.Shared.Enums
@inject IDeadlineService DeadlineService
@inject IVehicleService VehicleService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Scadenze — Vehicle Manager</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Scadenze</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="ApriForm">Nuova scadenza</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTabs Elevation="2" Rounded="true" PanelClass="pa-3">
        <MudTabPanel Text="Tutte">
            <ScadenzeTabella Items="_tutte" OnElimina="Elimina" />
        </MudTabPanel>
        <MudTabPanel Text="@($"Scadute ({_scadute.Count})")" BadgeColor="Color.Error" BadgeDot="@(_scadute.Any())">
            <ScadenzeTabella Items="_scadute" OnElimina="Elimina" />
        </MudTabPanel>
        <MudTabPanel Text="@($"In scadenza ({_inScadenza.Count})")" BadgeColor="Color.Warning" BadgeDot="@(_inScadenza.Any())">
            <ScadenzeTabella Items="_inScadenza" OnElimina="Elimina" />
        </MudTabPanel>
    </MudTabs>
}

<!-- Dialog nuova scadenza -->
