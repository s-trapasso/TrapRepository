@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}

@code {
    private List<DeadlineDto> _tutte = [];
    private List<DeadlineDto> _scadute = [];
    private List<DeadlineDto> _inScadenza = [];
    private List<VehicleSummaryDto> _vehicles = [];
    private bool _loading = true;
    private bool _formOpen = false;
    private bool _saving = false;
    private CreateDeadlineDto _newDeadline = new();
    private DateTime? _scadenzaDate;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CaricaDati();
        }
        catch (Exception ex)
        {
            _error = ex.Message + " — " + ex.StackTrace;
        }
        // Apri direttamente il form se siamo su /scadenze/nuova
        if (Nav.Uri.EndsWith("/nuova")) _formOpen = true;
    }

    private async Task CaricaDati()
    {
        _loading = true;
        var tTask = DeadlineService.GetAllAsync();
        var sTask = DeadlineService.GetScaduteAsync();
        var iTask = DeadlineService.GetInScadenzaAsync();
        var vTask = VehicleService.GetAllAsync();
        await Task.WhenAll(tTask, sTask, iTask, vTask);

        var t = await tTask; if (t.Success) _tutte = t.Data ?? [];
        var s = await sTask; if (s.Success) _scadute = s.Data ?? [];
        var i = await iTask; if (i.Success) _inScadenza = i.Data ?? [];
        var v = await vTask; if (v.Success) _vehicles = v.Data ?? [];
        _loading = false;
    }

    private void ApriForm()
    {
        _newDeadline = new CreateDeadlineDto();
        _scadenzaDate = null;
        _formOpen = true;
    }

    private async Task SalvaScadenza()
    {
        if (_scadenzaDate.HasValue)
            _newDeadline.DataScadenza = DateOnly.FromDateTime(_scadenzaDate.Value);

        _saving = true;
        var response = await DeadlineService.CreateAsync(_newDeadline);
        if (response.Success)
        {
            Snackbar.Add("Scadenza salvata!", Severity.Success);
            _formOpen = false;
            await CaricaDati();
        }
        else
        {
            Snackbar.Add(response.ErrorMessage ?? "Errore.", Severity.Error);
        }
        _saving = false;
    }

    private async Task Elimina(int id)
    {
        var response = await DeadlineService.DeleteAsync(id);
        if (response.Success)
        {
            Snackbar.Add("Scadenza eliminata.", Severity.Success);
            await CaricaDati();
        }
    }
}
