@code {
    private List<OwnerDto> _owners = [];
    private bool _loading = true;
    private bool _formOpen = false;
    private bool _saving = false;
    private int? _editId;
    private CreateOwnerDto _form = new();
    private DateTime? _patenteScadenzaDate;
    private DateTime? _visitaScadenzaDate;

    protected override async Task OnInitializedAsync() => await Carica();

    private async Task Carica()
    {
        _loading = true;
        var r = await OwnerService.GetAllAsync();
        if (r.Success) _owners = r.Data ?? [];
        _loading = false;
    }

    private void ApriForm()
    {
        _editId = null;
        _form = new CreateOwnerDto();
        _patenteScadenzaDate = null;
        _visitaScadenzaDate = null;
        _formOpen = true;
    }

    private void ApriModifica(OwnerDto o)
    {
        _editId = o.Id;
        _form = new CreateOwnerDto
        {
            Nome = o.Nome,
            Cognome = o.Cognome,
            Telefono = o.Telefono,
            Email = o.Email,
            CodiceFiscale = o.CodiceFiscale,
            Indirizzo = o.Indirizzo,
            Note = o.Note,
            PatenteCategoria = o.PatenteCategoria,
            PatenteNumero = o.PatenteNumero,
            PatenteScadenza = o.PatenteScadenza,
            PatenteMedicaScadenza = o.PatenteMedicaScadenza
        };
        _patenteScadenzaDate = o.PatenteScadenza?.ToDateTime(TimeOnly.MinValue);
        _visitaScadenzaDate = o.PatenteMedicaScadenza?.ToDateTime(TimeOnly.MinValue);
        _formOpen = true;
    }

    private async Task Salva()
    {
        _form.PatenteScadenza = _patenteScadenzaDate.HasValue
            ? DateOnly.FromDateTime(_patenteScadenzaDate.Value) : null;
        _form.PatenteMedicaScadenza = _visitaScadenzaDate.HasValue
            ? DateOnly.FromDateTime(_visitaScadenzaDate.Value) : null;

        _saving = true;
        ApiResponse<OwnerDto> r;

        if (_editId == null)
            r = await OwnerService.CreateAsync(_form);
        else
            r = await OwnerService.UpdateAsync(_editId.Value, new UpdateOwnerDto
            {
                Nome = _form.Nome,
                Cognome = _form.Cognome,
                Telefono = _form.Telefono,
                Email = _form.Email,
                CodiceFiscale = _form.CodiceFiscale,
                Indirizzo = _form.Indirizzo,
                Note = _form.Note,
                PatenteCategoria = _form.PatenteCategoria,
                PatenteNumero = _form.PatenteNumero,
                PatenteScadenza = _form.PatenteScadenza,
                PatenteMedicaScadenza = _form.PatenteMedicaScadenza
            });

        if (r.Success)
        {
            Snackbar.Add(_editId == null ? "Proprietario creato!" : "Proprietario aggiornato!", Severity.Success);
            _formOpen = false;
            await Carica();
        }
        else
        {
            Snackbar.Add(r.ErrorMessage ?? "Errore.", Severity.Error);
        }
        _saving = false;
    }

    private async Task Elimina(OwnerDto o)
    {
        var result = await DialogService.ShowMessageBox("Conferma",
            $"Eliminare {o.NomeCompleto}?", yesText: "Elimina", cancelText: "Annulla");
        if (result == true)
        {
            var r = await OwnerService.DeleteAsync(o.Id);
            if (r.Success) { Snackbar.Add("Eliminato.", Severity.Success); await Carica(); }
            else Snackbar.Add(r.ErrorMessage ?? "Errore.", Severity.Error);
        }
    }

    private Color StatoColor(DeadlineStatus stato) => stato switch
    {
        DeadlineStatus.Scaduta => Color.Error,
        DeadlineStatus.InScadenza => Color.Warning,
        _ => Color.Success
    };
}
