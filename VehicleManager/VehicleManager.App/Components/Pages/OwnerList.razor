@page "/proprietari"
@using VehicleManager.App.Services
@using VehicleManager.Shared.DTOs
@using VehicleManager.Shared.Enums
@inject IOwnerService OwnerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Proprietari — Vehicle Manager</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Proprietari</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="ApriForm">Nuovo proprietario</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Elevation="2">
        <MudTable Items="_owners" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Telefono</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Patente</MudTh>
                <MudTh>Scad. patente</MudTh>
                <MudTh>Visita medica</MudTh>
                <MudTh>Veicoli</MudTh>
                <MudTh>Azioni</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><b>@context.NomeCompleto</b></MudTd>
                <MudTd>@(context.Telefono ?? "—")</MudTd>
                <MudTd>@(context.Email ?? "—")</MudTd>
                <MudTd>
                    @if (!string.IsNullOrEmpty(context.PatenteCategoria))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @context.PatenteCategoria — @context.PatenteNumero
                        </MudChip>
                    }
                    else
                    {

                        <span>—</span>
                    }
                </MudTd>
                <MudTd>
                    @if (context.PatenteScadenza.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@StatoColor(context.StatoPatente)">
                            @context.PatenteScadenza.Value.ToString("dd/MM/yyyy")
                        </MudChip>
                    }
                    else
                    {

                        <span>—</span>
                    }
                </MudTd>
                <MudTd>
                    @if (context.PatenteMedicaScadenza.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@StatoColor(context.StatoVisitaMedica)">
                            @context.PatenteMedicaScadenza.Value.ToString("dd/MM/yyyy")
                        </MudChip>
                    }
                    else
                    {

                        <span>—</span>
                    }
                </MudTd>
                <MudTd>@context.NumeroVeicoli</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small" Color="Color.Warning"
                                   OnClick="@(() => ApriModifica(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => Elimina(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">Nessun proprietario registrato.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

