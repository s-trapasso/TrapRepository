<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.15" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- AutoMapper: mapping automatico Entity <-> DTO -->
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.0" />
    <!-- Swagger / OpenAPI: UI per testare gli endpoint -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!-- Serilog: logging strutturato su file + console -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <!-- FluentValidation: validazione request in ingresso -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\VehicleManager.Data\VehicleManager.Data.csproj" />
    <ProjectReference Include="..\VehicleManager.Shared\VehicleManager.Shared.csproj" />
  </ItemGroup>

</Project>
